# Copia este archivo como .env y rellena los valores.
# .env esta en .gitignore, no se sube al repositorio.
#
# DB_PASSWORD  clave de PostgreSQL en Supabase (Settings > Database)
# DB_URL       URL JDBC; usa el Session pooler para redes IPv4
# DB_USERNAME  usuario de Session pooler
# JWT_SECRET   clave de firma de los tokens, 64 caracteres hexadecimales
#
# No hace falta configurar nada en IntelliJ: application.properties importa
# este archivo con spring.config.import.

DB_PASSWORD=
DB_URL=jdbc:postgresql://aws-1-ca-central-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.ruvuaponemmepdwnqfce
JWT_SECRET=

# Storage: clave exclusiva del servidor (sb_secret_... o service_role legacy).
# No usar una publishable key, un token personal sbp_ ni el JWT de Autopartes.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_BUCKET=autopartes-imagenes
