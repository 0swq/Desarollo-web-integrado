@baseUrl = http://localhost:8080
@token =
@categoriaId =

###
# @capture categoriaId=id
POST {{baseUrl}}/api/categorias
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Frenos",
  "descripcion": "Pastillas, discos y tambores de freno",
  "imagenUrl": null,
  "activo": true
}

###
GET {{baseUrl}}/api/categorias
Authorization: Bearer {{tokenAdmin}}

###
GET {{baseUrl}}/api/categorias/{{categoriaId}}
Authorization: Bearer {{tokenAdmin}}

###
PUT {{baseUrl}}/api/categorias/{{categoriaId}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Frenos",
  "descripcion": "Sistema de frenos completo",
  "imagenUrl": null,
  "activo": true
}

###
PATCH {{baseUrl}}/api/categorias/{{categoriaId}}/toggle-activo
Authorization: Bearer {{tokenAdmin}}

###
DELETE {{baseUrl}}/api/categorias/{{categoriaId}}
Authorization: Bearer {{tokenAdmin}}
