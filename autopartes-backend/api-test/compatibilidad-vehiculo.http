@baseUrl = http://localhost:8080/api
@token =
@compatibilidadId =
@productoId =
@modeloId =

###
# @capture compatibilidadId=id
POST {{baseUrl}}/api/compatibilidades-vehiculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productoId": "{{productoId}}",
  "modeloVehiculoId": "{{modeloId}}",
  "anioInicio": 2015,
  "anioFin": 2022,
  "motor": "1.8L",
  "notas": "Solo version full"
}

###
GET {{baseUrl}}/api/compatibilidades-vehiculos
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/compatibilidades-vehiculos/{{compatibilidadId}}
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/compatibilidades-vehiculos/producto/{{productoId}}
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/compatibilidades-vehiculos/modelo/{{modeloId}}
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/compatibilidades-vehiculos/compatibles?modeloId={{modeloId}}&anio=2020
Authorization: Bearer {{token}}

###
DELETE {{baseUrl}}/api/compatibilidades-vehiculos/{{compatibilidadId}}
Authorization: Bearer {{token}}

###
DELETE {{baseUrl}}/api/compatibilidades-vehiculos/producto/{{productoId}}
Authorization: Bearer {{token}}
