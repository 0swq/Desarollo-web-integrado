@baseUrl = http://localhost:8080/api
@token =
@marcaId =

###
# @capture marcaId=id
POST {{baseUrl}}/api/marcas-vehiculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "{{nombreMarca}}",
  "paisOrigen": "Japon",
  "activo": true
}

###
GET {{baseUrl}}/api/marcas-vehiculos
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/marcas-vehiculos/{{marcaId}}
Authorization: Bearer {{token}}

###
PUT {{baseUrl}}/api/marcas-vehiculos/{{marcaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "{{nombreMarca}}",
  "paisOrigen": "Japon",
  "activo": true
}

###
PATCH {{baseUrl}}/api/marcas-vehiculos/{{marcaId}}/toggle-activo
Authorization: Bearer {{token}}

###
DELETE {{baseUrl}}/api/marcas-vehiculos/{{marcaId}}
Authorization: Bearer {{token}}
