@baseUrl = http://localhost:8080
@token =
@modeloId =
@marcaId =

###
# @capture modeloId=id
POST {{baseUrl}}/api/modelos-vehiculos
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "{{nombreModelo}}",
  "marcaId": "{{marcaId}}",
  "tipoVehiculo": "Sedan",
  "activo": true
}

###
GET {{baseUrl}}/api/modelos-vehiculos
Authorization: Bearer {{tokenAdmin}}

###
GET {{baseUrl}}/api/modelos-vehiculos/marca/{{marcaId}}
Authorization: Bearer {{tokenAdmin}}

###
GET {{baseUrl}}/api/modelos-vehiculos/{{modeloId}}
Authorization: Bearer {{tokenAdmin}}

###
PUT {{baseUrl}}/api/modelos-vehiculos/{{modeloId}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "{{nombreModelo}}",
  "marcaId": "{{marcaId}}",
  "tipoVehiculo": "Sedan",
  "activo": true
}

###
PATCH {{baseUrl}}/api/modelos-vehiculos/{{modeloId}}/toggle-activo
Authorization: Bearer {{tokenAdmin}}

###
DELETE {{baseUrl}}/api/modelos-vehiculos/{{modeloId}}
Authorization: Bearer {{tokenAdmin}}
