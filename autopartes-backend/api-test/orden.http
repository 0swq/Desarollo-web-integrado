@baseUrl = http://localhost:8080
@token =
@tokenAdmin =
@ordenId =
@numeroOrden =
@usuarioId =

###
# @capture ordenId=id numeroOrden=numeroOrden
POST {{baseUrl}}/api/ordenes/usuario/{{usuarioId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "direccionEntrega": "Av. Lima 123",
  "telefonoContacto": "999888777",
  "notas": "Entregar en horario de oficina",
  "metodoPago": "MERCADO_PAGO"
}

###
GET {{baseUrl}}/api/ordenes/usuario/{{usuarioId}}
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/ordenes
Authorization: Bearer {{tokenAdmin}}

###
GET {{baseUrl}}/api/ordenes/{{ordenId}}
Authorization: Bearer {{tokenAdmin}}

###
GET {{baseUrl}}/api/ordenes/numero/{{numeroOrden}}
Authorization: Bearer {{tokenAdmin}}

###
GET {{baseUrl}}/api/ordenes/estado/PENDIENTE
Authorization: Bearer {{tokenAdmin}}

###
PATCH {{baseUrl}}/api/ordenes/{{ordenId}}/estado
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "estado": "PAGADO"
}