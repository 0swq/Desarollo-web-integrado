@baseUrl = http://localhost:8080/api
@token =
@pagoId =
@ordenId =
@ordenSinPago =
@totalOrden = 0

###
# @expect 400
POST {{baseUrl}}/api/pagos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ordenId": "{{ordenSinPago}}",
  "monto": {{totalOrden}},
  "moneda": "PEN",
  "metodoPago": "MERCADO_PAGO"
}

###
# @capture pagoId=id
GET {{baseUrl}}/api/pagos/orden/{{ordenSinPago}}
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/pagos
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/pagos/{{pagoId}}
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/pagos/orden/{{ordenSinPago}}
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/pagos/estado/PENDIENTE
Authorization: Bearer {{token}}

###
PATCH {{baseUrl}}/api/pagos/{{pagoId}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "APROBADO"
}

###
PATCH {{baseUrl}}/api/pagos/{{pagoId}}/mercado-pago
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "mercadoPagoPagoId": "123456789",
  "mercadoPagoPreferenciaId": "pref-abc-123"
}
