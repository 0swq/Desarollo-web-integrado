@baseUrl = http://localhost:8080/api
@token =
@proveedorId =

###
# @capture proveedorId=id
POST {{baseUrl}}/api/proveedores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ruc": "{{ruc}}",
  "razonSocial": "Repuestos del Sur S.A.C.",
  "contactoNombre": "Luis Torres",
  "telefono": "014445566",
  "correo": "ventas@repsur.com",
  "direccion": "Av. Industrial 789",
  "activo": true
}

###
GET {{baseUrl}}/api/proveedores
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/proveedores/{{proveedorId}}
Authorization: Bearer {{token}}

###
PUT {{baseUrl}}/api/proveedores/{{proveedorId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ruc": "{{ruc}}",
  "razonSocial": "Repuestos del Sur S.A.C.",
  "contactoNombre": "Luis Torres",
  "telefono": "014445566",
  "correo": "ventas@repsur.com",
  "direccion": "Av. Industrial 789",
  "activo": true
}

###
PATCH {{baseUrl}}/api/proveedores/{{proveedorId}}/toggle-activo
Authorization: Bearer {{token}}

###
DELETE {{baseUrl}}/api/proveedores/{{proveedorId}}
Authorization: Bearer {{token}}
